    <section class="section reveal">
      <div class="section-heading"><h2>Relationship statistics</h2><p class="muted">Peer-reviewed and definitely scientifically accurate.</p></div>
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-value">3</div><div class="stat-label">months together</div></div>
